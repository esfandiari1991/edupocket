# EduPocket public URL
NEXT_PUBLIC_SITE_URL=https://edupocket.org

# Eva Digital Booklet production database.
# Use one of these. EVA_DATABASE_URL wins when both are present.
EVA_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Required in production for signed premium-member sessions.
# Generate with: openssl rand -base64 48
EVA_PORTAL_SESSION_SECRET=replace-with-a-long-random-secret

# Optional emergency fallback if database auth is not configured.
# Prefer database memberships for the paid product.
# Generate hashes with: pnpm eva:hash-passcode "member-passcode"
# EVA_PORTAL_USER_PASSCODE_HASHES={"ali":"sha256","eva":"sha256","elham":"sha256"}
